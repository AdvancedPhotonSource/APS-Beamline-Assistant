  "@type": "sc:Dataset",
  "name": "APEXA-Bench",
  "alternateName": "APEXA Beamline Agent Benchmark",
  "description": "An evaluation benchmark for large-language-model agents operating on synchrotron beamline workflows. Contains 58 standard tasks across six domain categories (calibration, integration, HEDM analysis, motor control, phase identification, domain knowledge) and three difficulty levels (L1 single-tool, L2 multi-tool, L3 multi-agent pipeline), plus 50 adversarial safety scenarios. Includes an 8-task cross-detector zoo (ref_01..ref_08) that exercises the calibrate-integrate-refine pipeline on four physically distinct detectors against a NIST-traceable lattice constant for CeO2.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/AdvancedPhotonSource/APS-Beamline-Assistant",
  "version": "1.0.0",
  "datePublished": "2026-05-04",
  "creator": {
    "@type": "Organization",
    "name": "APEXA team, Advanced Photon Source, Argonne National Laboratory",
    "url": "https://www.aps.anl.gov/"
  },
  "keywords": [
    "LLM agents",
    "scientific benchmarks",
    "synchrotron",
    "high-energy diffraction microscopy",
    "HEDM",
    "physical-consequence evaluation",
    "agent safety",
    "Rietveld refinement",
    "EPICS motor control"
  ],
  "citeAs": "Tripathi, P. et al. (2026). APEXA-Bench: A Benchmark for LLM Agents on Synchrotron Beamline Workflows.",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "github-repo",
      "name": "github-repo",
      "description": "APEXA-Bench source repository on GitHub.",
      "contentUrl": "https://github.com/AdvancedPhotonSource/APS-Beamline-Assistant",
      "encodingFormat": "git+https",
      "sha256": "main"
    },
    {
      "@type": "cr:FileObject",
      "@id": "tasks-json",
      "name": "tasks-json",
      "description": "Task definitions for the 58 standard tasks.",
      "containedIn": {"@id": "github-repo"},
      "contentUrl": "benchmark/benchmark_tasks.json",
      "encodingFormat": "application/json"
    },
    {
      "@type": "cr:FileObject",
      "@id": "detector-zoo-gt",
      "name": "detector-zoo-gt",
      "description": "Ground-truth manifest for the 8-task cross-detector zoo.",
      "containedIn": {"@id": "github-repo"},
      "contentUrl": "benchmark/detector_zoo/ground_truth.json",
      "encodingFormat": "application/json"
    },
    {
      "@type": "cr:FileObject",
      "@id": "datasheet",
      "name": "datasheet",
      "description": "Datasheet (Gebru et al. 2018) describing the dataset.",
      "containedIn": {"@id": "github-repo"},
      "contentUrl": "benchmark/DATASHEET.md",
      "encodingFormat": "text/markdown"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "tasks",
      "name": "tasks",
      "description": "One record per benchmark task.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "tasks/id",
          "name": "id",
          "description": "Unique task identifier (e.g., cal_03, ref_05).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {"@id": "tasks-json"},
            "extract": {"jsonPath": "$.tasks[*].id"}
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/category",
          "name": "category",
          "description": "Domain category (calibration, integration, hedm, motor, phase_id, knowledge).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {"@id": "tasks-json"},
            "extract": {"jsonPath": "$.tasks[*].category"}
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/difficulty",
          "name": "difficulty",
          "description": "Difficulty level (L1 single-tool, L2 multi-tool, L3 pipeline).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {"@id": "tasks-json"},
            "extract": {"jsonPath": "$.tasks[*].difficulty"}
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/prompt",
          "name": "prompt",
          "description": "Natural-language prompt fed to the agent.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {"@id": "tasks-json"},
            "extract": {"jsonPath": "$.tasks[*].prompt"}
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/consequence",
          "name": "consequence",
          "description": "Physical-consequence class: Informational (I), Computational (C), Physical-reversible (P_R), Physical-irreversible (P_I).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {"@id": "tasks-json"},
            "extract": {"jsonPath": "$.tasks[*].consequence"}
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "detector-zoo-detectors",
      "name": "detector-zoo-detectors",
      "description": "Ground-truth lattice-constant accuracy for each of the four detectors in the cross-detector zoo (post-fix v2 driver).",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "detector-zoo-detectors/name",
          "name": "name",
          "description": "Detector identifier.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {"@id": "detector-zoo-gt"},
            "extract": {"jsonPath": "$.detectors.*~"}
          }
        },
        {
          "@type": "cr:Field",
          "@id": "detector-zoo-detectors/wavelength_A",
          "name": "wavelength_A",
          "description": "X-ray wavelength used for the calibration image (angstroms).",
          "dataType": "sc:Float",
          "source": {
            "fileObject": {"@id": "detector-zoo-gt"},
            "extract": {"jsonPath": "$.detectors.*.wavelength_A"}
          }
        },
        {
          "@type": "cr:Field",
          "@id": "detector-zoo-detectors/abs_da_mA",
          "name": "abs_da_mA",
          "description": "Absolute deviation of refined CeO2 lattice constant from NIST SRM 674b reference (5.41165 A), in milliangstroms, post-fix v2 driver.",
          "dataType": "sc:Float",
          "source": {
            "fileObject": {"@id": "detector-zoo-gt"},
            "extract": {"jsonPath": "$.detectors.*.ground_truth.abs_da_mA"}
          }
        }
      ]
    }
  ]
}
